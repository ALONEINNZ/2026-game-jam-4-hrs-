[sub_resource type="Shader" id="Shader_ee4bf"]
code = "shader_type canvas_item;

uniform vec4 glow_color : source_color = vec4(0.0, 0.8, 1.0, 1.0);
uniform float hover_intensity : hint_range(0.0, 1.0) = 0.0;

void fragment() {
    vec4 current_color = texture(TEXTURE, UV);
    
    // Create an outer pulse glow when hovered
    float pulse = (sin(TIME * 5.0) * 0.5 + 0.5) * hover_intensity;
    vec4 glow = glow_color * pulse * 0.4;
    
    // Mix the base button texture with the glow effect
    COLOR = current_color + glow;
}
"

